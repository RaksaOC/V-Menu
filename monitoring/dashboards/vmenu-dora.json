{
  "uid": "vmenu-dora",
  "title": "V-Menu DORA",
  "description": "Delivery metrics, read automatically from each environment's deploy-history.log.",
  "tags": [
    "vmenu"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/-prom$/",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/-logs$/",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(up{job=\"vmenu-services\"}, env)",
          "refId": "var"
        },
        "definition": "label_values(up{job=\"vmenu-services\"}, env)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Deployment frequency (per day)",
      "description": "Successful deploys per day over the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum(count_over_time({job=\"vmenu-deploys\",env=\"$env\",action=\"deploy\",result=\"ok\"}[$__range])) / ($__range_s / 86400)",
          "refId": "A",
          "legendFormat": "Deployment frequency (per day)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Change failure rate",
      "description": "Failed deploys as a share of all deploy attempts.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "(sum(count_over_time({job=\"vmenu-deploys\",env=\"$env\",action=\"deploy\",result=\"failed\"}[$__range])) or vector(0)) / sum(count_over_time({job=\"vmenu-deploys\",env=\"$env\",action=\"deploy\"}[$__range]))",
          "refId": "A",
          "legendFormat": "Change failure rate",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.15
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Time to restore (average)",
      "description": "Average run time of successful rollbacks. For an automatic rollback this includes the failed deploy before it. It does not include time before someone started a manual rollback.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum(sum_over_time({job=\"vmenu-deploys\",env=\"$env\",action=~\"rollback|auto-rollback\",result=\"ok\"} | unwrap seconds [$__range])) / sum(count_over_time({job=\"vmenu-deploys\",env=\"$env\",action=~\"rollback|auto-rollback\",result=\"ok\"}[$__range]))",
          "refId": "A",
          "legendFormat": "Time to restore (average)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lead time for changes",
      "description": "Average time from commit to live. Each deploy records the average age of the commits it ships.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum(sum_over_time({job=\"vmenu-deploys\",env=\"$env\",action=\"lead-time\"} | unwrap seconds [$__range])) / sum(count_over_time({job=\"vmenu-deploys\",env=\"$env\",action=\"lead-time\"}[$__range]))",
          "refId": "A",
          "legendFormat": "Lead time for changes",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Deploys per day",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "interval": "1d",
      "maxDataPoints": 60,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum by (result) (count_over_time({job=\"vmenu-deploys\",env=\"$env\",action=\"deploy\"}[1d]))",
          "refId": "A",
          "legendFormat": "{{result}}",
          "queryType": "range",
          "step": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Average deploy time",
      "description": "Average run time of successful deploys.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum(sum_over_time({job=\"vmenu-deploys\",env=\"$env\",action=\"deploy\",result=\"ok\"} | unwrap seconds [$__range])) / sum(count_over_time({job=\"vmenu-deploys\",env=\"$env\",action=\"deploy\",result=\"ok\"}[$__range]))",
          "refId": "A",
          "legendFormat": "Average deploy time",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Rollbacks",
      "description": "Manual and automatic rollbacks in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum(count_over_time({job=\"vmenu-deploys\",env=\"$env\",action=~\"rollback|auto-rollback\"}[$__range]))",
          "refId": "A",
          "legendFormat": "Rollbacks",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Deploy history",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{job=\"vmenu-deploys\",env=\"$env\",action!=\"lead-time\"}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ]
}
