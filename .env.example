# Copy to .env and fill in your Firebase web config (same values as frontend/.env.local).
# `docker compose` reads .env automatically and passes these to the frontend build.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Grafana Cloud, for the monitoring agent (monitoring/). The values are on your stack's
# Prometheus and Loki Details pages. The token needs only metrics:write and logs:write.
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_CLOUD_TOKEN=
