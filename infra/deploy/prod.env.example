# V-Menu PRODUCTION: every value the deploy needs, and where it lives.
#
# Same names as staging.env.example, stored in the GitHub Environment "production".
# The workflow writes /srv/vmenu/prod/.env and /srv/vmenu/prod/services/<service>/.env.
# Values marked (differs) must NOT be the same as staging.
#
# ---- GitHub Environment "production" -> Secrets ----
SSH_HOST=203.0.113.7                     # same server as staging
SSH_USER=deploy
SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...   # same CI key as staging is fine
SSH_KNOWN_HOSTS=203.0.113.7 ssh-ed25519 AAAA...
MONGODB_URI_RESTAURANT=mongodb://vmenu_prod:PASSWORD@host.docker.internal:27017/vmenu_prod_restaurants?authSource=admin   # (differs)
MONGODB_URI_MENU=mongodb://vmenu_prod:PASSWORD@host.docker.internal:27017/vmenu_prod_menu?authSource=admin                # (differs)
MONGODB_URI_ORDER=mongodb://vmenu_prod:PASSWORD@host.docker.internal:27017/vmenu_prod_orders?authSource=admin             # (differs)
JWT_SECRET=                              # (differs) openssl rand -hex 32
INTERNAL_API_KEY=                        # (differs) openssl rand -hex 32

# ---- GitHub Environment "production" -> Variables (not secret) ----
FRONTEND_PORT=3400                       # (differs) must match PROD_PORT in setup-server.sh
PUBLIC_URL=https://example.com           # (differs)
MONGO_MODE=host
MONGO_NETWORK=
FIREBASE_PROJECT_ID=v-menu-e9835
LOG_LEVEL=info
SSH_PORT=22

# ---- set by the workflow / fixed ----
# TAG=1.2.0              from the git tag v1.2.0
# SERVICE_NAME, PORT, COOKIE_SECURE=true
