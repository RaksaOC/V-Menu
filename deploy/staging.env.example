# V-Menu STAGING: every value the deploy needs, and where it lives.
#
# Nothing here is copied to the server by hand. The deploy workflow reads these from the
# GitHub Environment "staging" and writes the server files itself:
#   /srv/vmenu/staging/.env                               FRONTEND_PORT, MONGO_MODE, MONGO_NETWORK, TAG
#   /srv/vmenu/staging/services/<service>/.env            the rest (chmod 600)
#
# ---- GitHub Environment "staging" -> Secrets ----
SSH_HOST=203.0.113.7                     # server IP or hostname
SSH_USER=deploy
SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...   # private half of the CI key (whole file)
SSH_KNOWN_HOSTS=203.0.113.7 ssh-ed25519 AAAA...  # printed by setup-server.sh (recommended)
MONGODB_URI_RESTAURANT=mongodb://vmenu_staging:PASSWORD@host.docker.internal:27017/vmenu_staging_restaurants?authSource=admin
MONGODB_URI_MENU=mongodb://vmenu_staging:PASSWORD@host.docker.internal:27017/vmenu_staging_menu?authSource=admin
MONGODB_URI_ORDER=mongodb://vmenu_staging:PASSWORD@host.docker.internal:27017/vmenu_staging_orders?authSource=admin
JWT_SECRET=                              # openssl rand -hex 32   (32+ characters, different from prod)
INTERNAL_API_KEY=                        # openssl rand -hex 32   (different from prod)

# ---- GitHub Environment "staging" -> Variables (not secret) ----
FRONTEND_PORT=3401                       # must match STAGING_PORT in setup-server.sh
PUBLIC_URL=https://staging.example.com   # shown as the deployment link in GitHub
MONGO_MODE=host                          # host | container | none
MONGO_NETWORK=                           # only for MONGO_MODE=container
FIREBASE_PROJECT_ID=v-menu-e9835
LOG_LEVEL=info
SSH_PORT=22                              # optional

# ---- set by the workflow / fixed, no need to add ----
# TAG=sha-1a2b3c4        image tag being deployed
# SERVICE_NAME, PORT     4101 restaurant, 4102 menu, 4103 order
# COOKIE_SECURE=true     restaurant-service, because Caddy serves HTTPS
