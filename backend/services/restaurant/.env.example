# restaurant-service settings. Copy to .env (npm run setup does this for you).
SERVICE_NAME=restaurant-service
PORT=4101
# This service's own database. Local: mongodb://127.0.0.1:27017/vmenu_restaurants
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vmenu_restaurants
MONGODB_URI=mongodb://127.0.0.1:27017/vmenu_restaurants
# Must be the same in all three services (npm run setup generates them)
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
INTERNAL_API_KEY=change-me-to-another-random-string
# Firebase project whose ID tokens are accepted (no service-account key needed)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Set to false only when serving over plain http on a host other than localhost
COOKIE_SECURE=true
LOG_LEVEL=info
# How long a sign-in lasts, in hours (1-24). Token and cookie use the same value (VM-03).
SESSION_HOURS=12
