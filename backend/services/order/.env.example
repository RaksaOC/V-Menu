# order-service settings. Copy to .env (npm run setup does this for you).
SERVICE_NAME=order-service
PORT=4103
# This service's own database. Local: mongodb://127.0.0.1:27017/vmenu_orders
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vmenu_orders
MONGODB_URI=mongodb://127.0.0.1:27017/vmenu_orders
# Must be the same in all three services (npm run setup generates them)
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
INTERNAL_API_KEY=change-me-to-another-random-string
RESTAURANT_SERVICE_URL=http://127.0.0.1:4101
MENU_SERVICE_URL=http://127.0.0.1:4102
LOG_LEVEL=info
# VM-22: orders per client address per minute, and per table per 10 minutes. A whole restaurant on
# one Wi-Fi network can share an address, so raise the first number if busy tables get "please wait".
ORDERS_PER_MINUTE=10
ORDERS_PER_TABLE=30
# SEC-01: browsers sign in with the httpOnly cookie only. true also accepts "Authorization: Bearer"
# (for scripts and tests); leave it off on servers.
AUTH_ALLOW_BEARER=false
# SEC-01: writes (POST/PUT/PATCH/DELETE) from another site are refused. The site's own address is
# known from the request; list any other origins allowed to write, comma separated.
ALLOWED_ORIGINS=
