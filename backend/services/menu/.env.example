# menu-service settings. Copy to .env (npm run setup does this for you).
SERVICE_NAME=menu-service
PORT=4102
# This service's own database. Local: mongodb://127.0.0.1:27017/vmenu_menu
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vmenu_menu
MONGODB_URI=mongodb://127.0.0.1:27017/vmenu_menu
# Must be the same in all three services (npm run setup generates them)
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
INTERNAL_API_KEY=change-me-to-another-random-string
RESTAURANT_SERVICE_URL=http://127.0.0.1:4101
# VM-15: asked before a table is renamed or deleted (does it have an unpaid bill?)
ORDER_SERVICE_URL=http://127.0.0.1:4103
LOG_LEVEL=info
# Photo uploads allowed per restaurant per hour (SEC-05)
UPLOADS_PER_HOUR=30
# SEC-01: browsers sign in with the httpOnly cookie only. true also accepts "Authorization: Bearer"
# (for scripts and tests); leave it off on servers.
AUTH_ALLOW_BEARER=false
# SEC-01: writes (POST/PUT/PATCH/DELETE) from another site are refused. The site's own address is
# known from the request; list any other origins allowed to write, comma separated.
ALLOWED_ORIGINS=
# SEC-04: customers open a table through its QR link (/<slug>/t/<token>). true also allows the old
# links by table name, for local testing. npm run setup turns it on locally; leave it off on servers.
ALLOW_TABLE_NAME_LINKS=false
# PHOTOS-S3: menu photos live in S3-compatible object storage (MinIO). The values below match the
# MinIO in infra/compose (docker compose -f infra/compose/docker-compose.yml up -d minio).
# S3_ENDPOINT is where this service reaches it (inside Docker: http://minio:9000); S3_PUBLIC_URL is
# where browsers do (photo uploads and image links, e.g. https://files.example.com). Empty: the same.
S3_ENDPOINT=http://127.0.0.1:9400
S3_PUBLIC_URL=http://127.0.0.1:9400
S3_ACCESS_KEY=vmenu-local
S3_SECRET_KEY=vmenu-local-only
# One bucket per environment. The service makes it, with its clean-up rule, if it may.
S3_BUCKET=vmenu-photos
S3_REGION=us-east-1
