{
  "name": "vmenu-backend",
  "private": true,
  "description": "npm workspace for the V-Menu services and their shared packages. One package-lock.json covers all of them.",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "typescript-eslint": "8.72.2"
  }
}
